# ローカルruntime確認用。コピーして実際の開発用Auth0設定に置き換える。
# 以下はCIのCompose設定検証用ダミー値。実行用のSecretではない。
AUTH0_DOMAIN=example.auth0.com
AUTH0_CLIENT_ID=example-placeholder
AUTH0_CLIENT_SECRET=example-placeholder
AUTH0_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH0_AUDIENCE=https://example.invalid/
MEMORIA_GRAPHQL_URL=http://host.docker.internal:8080/graphql
