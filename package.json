{
  "name": "memoria-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:next": "next dev",
    "dev:storybook": "storybook dev -p 6006",
    "format": "biome format --write",
    "check": "biome check --changed --since=${BIOME_BASE_REF:-origin/develop} --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit",
    "build:next": "next build",
    "build:storybook": "storybook build",
    "build": "npm run build:next",
    "start": "next start",
    "lint": "next lint",
    "gen:graphql": "graphql-codegen",
    "test:unit": "vitest run",
    "test:vrt": "npm run build:storybook && playwright test --config=playwright.vrt.config.ts",
    "test:vrt:update": "npm run build:storybook && playwright test --config=playwright.vrt.config.ts --update-snapshots",
    "test:vrt:report": "playwright show-report ./e2e/vrt/report",
    "test:app": "playwright test --config=playwright.app.config.ts",
    "test:app:update": "playwright test --config=playwright.app.config.ts --update-snapshots",
    "test:app:report": "playwright show-report ./e2e/app/report",
    "storybook": "storybook dev -p 6006",
    "quality": "npm run gen:graphql && npm run check && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@auth0/nextjs-auth0": "^4.27.0",
    "@hookform/resolvers": "^5.9.1",
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@tabler/icons-react": "^3.46.0",
    "apollo-upload-client": "^17.0.0",
    "csrf": "^3.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "filesize": "^11.0.22",
    "framer-motion": "^12.16.0",
    "graphql": "^16.14.2",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "nanoid": "^5.1.5",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^15.5.3",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "universal-cookie": "^8.1.2",
    "zod": "^3.25.30",
    "zod-i18n-map": "^2.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@chromatic-com/storybook": "^5.3.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/mock": "^9.0.23",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@testing-library/react": "^16.3.0",
    "@types/apollo-upload-client": "^17.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.1.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
