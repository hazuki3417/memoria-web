{
  "name": "memoria-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "next start",
    "build:next": "npm run dev:assets && next build",
    "build:storybook": "storybook build",
    "build": "npm run build:next",
    "dev:next": "npm run dev:assets && next dev",
    "dev:storybook": "storybook dev -p 6006",
    "dev:assets": "node scripts/link-dev-assets.mjs",
    "format": "biome format --write",
    "check:format": "biome check --changed --since=${BIOME_BASE_REF:-origin/develop} --no-errors-on-unmatched",
    "check:lint": "biome lint .",
    "check:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:interaction": "vitest run --config vitest.storybook.config.ts",
    "test:visual": "playwright test --config=playwright.vrt.config.ts",
    "test:visual:update": "playwright test --config=playwright.vrt.config.ts --update-snapshots",
    "test:visual:report": "playwright show-report ./tests/vrt/report",
    "graphql:codegen": "graphql-codegen --config codegen.ts && node scripts/align-apollo-operation-types.mjs",
    "graphql:codegen:api": "graphql-codegen --config codegen.ts && node scripts/align-apollo-operation-types.mjs",
    "openapi:codegen": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.7",
    "@auth0/nextjs-auth0": "^4.27.0",
    "@hookform/resolvers": "^7.0.3",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/notifications": "^9.7.5",
    "@tabler/icons-react": "^3.50.0",
    "framer-motion": "^14.10.1",
    "graphql": "^17.1.0",
    "next": "^16.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-resizable-panels": "^4.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@faker-js/faker": "^10.6.0",
    "@graphql-codegen/cli": "^7.4.4",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-codegen/typescript-react-apollo": "^5.0.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/nextjs-vite": "^10.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "orval": "^8.46.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
