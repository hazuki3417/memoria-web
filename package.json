{
  "name": "memoria-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:storybook": "storybook dev -p 6006",
    "format": "biome format . --write",
    "build:next": "next build",
    "build:storybook": "storybook build",
    "start": "next start",
    "lint": "next lint",
    "gen:graphql": "graphql-codegen",
    "test:unit": "vitest run",
    "test:vrt": "npm run build:storybook && playwright test --config=playwright.vrt.config.ts",
    "test:vrt:update": "npm run build:storybook && playwright test --config=playwright.vrt.config.ts --update-snapshots",
    "test:vrt:report": "playwright show-report ./e2e/vrt/report",
    "test:app": "playwright test --config=playwright.app.config.ts",
    "test:app:update": "playwright test --config=playwright.app.config.ts --update-snapshots",
    "test:app:report": "playwright show-report ./e2e/app/report"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@auth0/nextjs-auth0": "^4.6.0",
    "@hookform/resolvers": "^5.0.1",
    "@mantine/core": "^8.0.1",
    "@mantine/hooks": "^8.0.1",
    "@mantine/notifications": "^8.0.1",
    "@tabler/icons-react": "^3.33.0",
    "apollo-upload-client": "^17.0.0",
    "csrf": "^3.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.16.0",
    "graphql": "^16.11.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "nanoid": "^5.1.5",
    "next": "^15.3.2",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.56.4",
    "react-i18next": "^15.5.3",
    "universal-cookie": "^8.0.1",
    "zod": "^3.25.30",
    "zod-i18n-map": "^2.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/mock": "^9.0.23",
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16.3.0",
    "@types/apollo-upload-client": "^17.0.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
