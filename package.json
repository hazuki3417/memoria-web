{
  "name": "memoria-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "next start",
    "build:next": "npm run dev:assets && next build",
    "build:storybook": "storybook build",
    "build": "npm run build:next",
    "dev:next": "npm run dev:assets && next dev",
    "dev:storybook": "storybook dev -p 6006",
    "dev:assets": "node scripts/link-dev-assets.mjs",
    "format": "biome format --write",
    "check:format": "biome check --changed --since=${BIOME_BASE_REF:-origin/develop} --no-errors-on-unmatched",
    "check:lint": "next lint",
    "check:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:interaction": "vitest run --config vitest.storybook.config.ts",
    "test:visual": "playwright test --config=playwright.storybook-visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.storybook-visual.config.ts --update-snapshots",
    "test:visual:report": "playwright show-report ./e2e/storybook-visual/report",
    "graphql:codegen": "graphql-codegen --config codegen.ts && node scripts/align-apollo-operation-types.mjs",
    "graphql:codegen:api": "graphql-codegen --config codegen.ts && node scripts/align-apollo-operation-types.mjs",
    "openapi:codegen": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@auth0/nextjs-auth0": "^4.27.0",
    "@hookform/resolvers": "^5.9.2",
    "@mantine/charts": "^9.7.3",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tabler/icons-react": "^3.46.0",
    "apollo-upload-client": "^20.0.0",
    "csrf": "^3.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "filesize": "^11.0.22",
    "framer-motion": "^14.6.0",
    "graphql": "^17.0.2",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.1.4",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "universal-cookie": "^8.1.2",
    "zod": "^4.6.7",
    "zod-i18n-map": "^2.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@chromatic-com/storybook": "^5.3.0",
    "@faker-js/faker": "^10.6.0",
    "@graphql-codegen/cli": "^7.4.4",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-codegen/typescript-react-apollo": "^5.0.0",
    "@graphql-tools/load-files": "^8.0.6",
    "@graphql-tools/mock": "^10.1.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@testing-library/react": "^16.3.0",
    "@types/apollo-upload-client": "^19.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "orval": "^8.45.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
