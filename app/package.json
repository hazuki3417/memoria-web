{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "biome format --write .",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "codegen:graphql": "graphql-codegen",
    "test:unit": "vitest run",
    "test:vrt": "npm run build:storybook && playwright test --config=playwright.vrt.config.ts",
    "test:vrt:update": "npm run build:storybook && playwright test --config=playwright.vrt.config.ts --update-snapshots",
    "test:vrt:report": "playwright show-report ./e2e/vrt/report",
    "test:app": "playwright test --config=playwright.app.config.ts",
    "test:app:update": "playwright test --config=playwright.app.config.ts --update-snapshots",
    "test:app:report": "playwright show-report ./e2e/app/report"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@auth0/nextjs-auth0": "^4.6.0",
    "@hookform/resolvers": "^5.0.1",
    "@mantine/core": "^8.0.1",
    "@mantine/hooks": "^8.0.1",
    "@tabler/icons-react": "^3.33.0",
    "csrf": "^3.1.0",
    "framer-motion": "^12.16.0",
    "graphql": "^16.11.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "nanoid": "^5.1.5",
    "next": "^15.3.2",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.56.4",
    "react-i18next": "^15.5.3",
    "universal-cookie": "^8.0.1",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/mock": "^9.0.23",
    "@playwright/test": "^1.52.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/addon-styling-webpack": "^1.0.1",
    "@storybook/blocks": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/test-runner": "^0.22.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "storybook": "^8.6.14",
    "storybook-dark-mode": "^4.0.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
