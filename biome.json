{
  "$schema": "https://biomejs.dev/schemas/1.8.0/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "include": ["src/**"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "files": {
    "ignore": [
      "*.snap",
      "**/.devbox/**",
      "**/.git/**",
      "**/.next/**",
      "**/.vscode/**",
      "**/coverage/**",
      "**/dist/**",
      "**/node_modules/**",
      "**/storybook-static/**",
      "**/test-results/**"
    ]
  }
}
